# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma separated Telegram numeric IDs allowed to delete records.
# Leave empty to allow everyone (development only).
ADMIN_IDS=

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Either the raw spreadsheet ID or the full https://docs.google.com/spreadsheets/d/<ID>/edit URL
GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/EXAMPLE_SPREADSHEET_ID/edit

# Tab (worksheet) name that holds the student rows
GOOGLE_SHEET_NAME=Students

# Credentials — use ONE of the three options below.
# Option 1: path to the service account JSON file (relative paths resolve from the project root)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Option 2: the whole service account JSON on a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option 3: credentials split across two variables (common on hosts with no file system)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@my-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ─── Google Gemini ───────────────────────────────────────────────────────────
# API key from https://aistudio.google.com/apikey — optional, the bot falls back
# to a local parser when it is missing or the API call fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Optional country code (digits only, no +) used to complete local WhatsApp numbers,
# e.g. 967 for Yemen, 966 for Saudi Arabia, 964 for Iraq. Leave empty to keep numbers as typed.
DEFAULT_COUNTRY_CODE=

# Timezone used in log timestamps and record metadata
TZ=Asia/Aden
