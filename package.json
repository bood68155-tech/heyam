{
  "name": "student-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot for student registration backed by Google Sheets and Google Gemini",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/selfcheck.js",
    "webhook:info": "node scripts/webhook.js info",
    "webhook:set": "node scripts/webhook.js set",
    "webhook:delete": "node scripts/webhook.js delete"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "googleapis": "^164.0.0",
    "grammy": "^1.38.3"
  }
}
